{
	"info": {
		"_postman_id": "d3f8a1c4-52b7-4e6a-9f10-8b27c4e19a55",
		"name": "CPS ONAP DMI Stack Demo",
		"description": "Exercises the DMI -> NCMP -> SDNC integration path against the optional onapDmiStack deployed by cps-charts.\n\nRequires the stack to be enabled:\n\n    helm install cps ./cps-charts --set onapDmiStack.enabled=true --timeout 20m\n\nUse the \"CPS Environment k8s (linux and windows)\" environment (Env_k8s.json).\n\nOn Linux/Minikube, NodePorts bind to the minikube IP rather than localhost. Either set CPS_HOST to the output of `minikube ip`, or run:\n\n    kubectl port-forward service/cps-ncmp-service 30080:8080\n    kubectl port-forward service/cps-ncmp-ncmp-dmi-plugin-service 30097:8080\n    kubectl port-forward service/cps-ncmp-sdnc-service 30096:8181\n\nNote: this collection targets the real ncmp-dmi-plugin, not dmi-stub. The dmi-stub is not deployed when onapDmiStack is enabled, so the DMI_HOST_1/DMI_HOST_2 variables are unused here.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Liveness & Readiness",
			"item": [
				{
					"name": "CPS Liveness Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://{{CPS_HOST}}:{{CPS_PORT}}/actuator/health/liveness",
							"protocol": "http",
							"host": [
								"{{CPS_HOST}}"
							],
							"port": "{{CPS_PORT}}",
							"path": [
								"actuator",
								"health",
								"liveness"
							]
						},
						"description": "Expects {\"status\":\"UP\"}"
					}
				},
				{
					"name": "DMI Plugin Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://{{CPS_HOST}}:{{DMI_PLUGIN_NODEPORT}}/actuator/health",
							"protocol": "http",
							"host": [
								"{{CPS_HOST}}"
							],
							"port": "{{DMI_PLUGIN_NODEPORT}}",
							"path": [
								"actuator",
								"health"
							]
						},
						"description": "Health of the real ncmp-dmi-plugin. Expects {\"status\":\"UP\"}"
					}
				},
				{
					"name": "SDNC Mounted Node Check",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "{{SDNC_AUTH}}"
							}
						],
						"url": {
							"raw": "http://{{CPS_HOST}}:{{SDNC_NODEPORT}}/rests/data/network-topology:network-topology/topology=topology-netconf?content=nonconfig",
							"protocol": "http",
							"host": [
								"{{CPS_HOST}}"
							],
							"port": "{{SDNC_NODEPORT}}",
							"path": [
								"rests",
								"data",
								"network-topology:network-topology",
								"topology=topology-netconf"
							],
							"query": [
								{
									"key": "content",
									"value": "nonconfig"
								}
							]
						},
						"description": "Confirms the simulated device is mounted in SDNC. Look for \"node-id\":\"ietfYang-PNFDemo\" with \"connection-status\":\"connected\"."
					}
				}
			]
		},
		{
			"name": "Demo Flow",
			"item": [
				{
					"name": "1. Register the cm-handle",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"dmiPlugin\": \"http://{{DMI_PLUGIN_HOST}}:{{DMI_PLUGIN_PORT}}\",\n  \"createdCmHandles\": [\n    {\n      \"cmHandle\": \"{{CM_HANDLE}}\",\n      \"cmHandleProperties\": {}\n    }\n  ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "http://{{CPS_HOST}}:{{CPS_PORT}}/ncmpInventory/v1/ch",
							"protocol": "http",
							"host": [
								"{{CPS_HOST}}"
							],
							"port": "{{CPS_PORT}}",
							"path": [
								"ncmpInventory",
								"v1",
								"ch"
							]
						},
						"description": "Registers the netconf node mounted in SDNC as a cm-handle, against the real ncmp-dmi-plugin."
					}
				},
				{
					"name": "2. Get CM handle state",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "{{basic_auth_171s}}"
							}
						],
						"url": {
							"raw": "http://{{CPS_HOST}}:{{CPS_PORT}}/ncmp/v1/ch/{{CM_HANDLE}}/state",
							"protocol": "http",
							"host": [
								"{{CPS_HOST}}"
							],
							"port": "{{CPS_PORT}}",
							"path": [
								"ncmp",
								"v1",
								"ch",
								"{{CM_HANDLE}}",
								"state"
							]
						},
						"description": "Module sync takes up to a minute. Expects \"cmHandleState\":\"READY\" before step 3 returns modules."
					}
				},
				{
					"name": "3. Get module references",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "{{basic_auth_171s}}"
							}
						],
						"url": {
							"raw": "http://{{CPS_HOST}}:{{CPS_PORT}}/ncmp/v1/ch/{{CM_HANDLE}}/modules",
							"protocol": "http",
							"host": [
								"{{CPS_HOST}}"
							],
							"port": "{{CPS_PORT}}",
							"path": [
								"ncmp",
								"v1",
								"ch",
								"{{CM_HANDLE}}",
								"modules"
							]
						},
						"description": "Returns the YANG modules read from the simulated device via SDNC, e.g. ietf-netconf, ietf-keystore, ietf-system."
					}
				},
				{
					"name": "4. De-register the cm-handle",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"dmiPlugin\": \"http://{{DMI_PLUGIN_HOST}}:{{DMI_PLUGIN_PORT}}\",\n  \"removedCmHandles\": [ \"{{CM_HANDLE}}\" ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "http://{{CPS_HOST}}:{{CPS_PORT}}/ncmpInventory/v1/ch",
							"protocol": "http",
							"host": [
								"{{CPS_HOST}}"
							],
							"port": "{{CPS_PORT}}",
							"path": [
								"ncmpInventory",
								"v1",
								"ch"
							]
						},
						"description": "Cleans up the cm-handle registered in step 1."
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "basic_auth_171s",
			"value": ""
		}
	]
}
